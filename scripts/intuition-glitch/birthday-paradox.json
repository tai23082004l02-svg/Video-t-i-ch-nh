  "lines": [
    {"scene":"question","parts":["How many strangers would you need","in a room before a shared birthday","becomes more likely than not?"],"pause":0.55},
    {"scene":"question","parts":["A hundred? Two hundred?"],"pause":0.8},
    {"scene":"room","parts":["Try twenty-three."],"pause":0.65},
    {"scene":"room","parts":["If that feels wrong,","hold on to that feeling."]},
    {"scene":"room","parts":["It points to the exact mistake","this puzzle exposes."]},
    {"scene":"you","parts":["You may be imagining someone","matching your birthday."]},
    {"scene":"you","parts":["But nobody has to match you."],"pause":0.5},
    {"scene":"pairs","parts":["Any two people can match."]},
    {"scene":"pairs","parts":["And every person who enters","creates more chances","than the one before."]},
    {"scene":"pairs","parts":["The second person creates","one possible pair."]},
    {"scene":"pairs","parts":["The third adds two more."]},
    {"scene":"network","parts":["By the time twenty-three people","are standing here,","there are 253 pairs."],"speech":"By the time twenty-three people are standing here, there are two hundred and fifty-three pairs."},
    {"scene":"network","parts":["You were looking at a small crowd.","The probability was looking","at a much bigger network."]},
    {"scene":"method","parts":["But counting pairs is only the clue.","Here is the calculation."]},
    {"scene":"method","parts":["Instead of asking","when birthdays collide,"],"pause":0.1},
    {"scene":"method","parts":["ask what it takes","for every birthday to be different."]},
    {"scene":"calendar","parts":["The first person can have","any birthday."]},
    {"scene":"calendar","parts":["The second must avoid","one occupied date."]},
    {"scene":"calendar","parts":["That leaves 364 out of 365 days."],"speech":"That leaves three hundred and sixty-four out of three hundred and sixty-five days."},
    {"scene":"calendar","parts":["If both birthdays are different,","the third must avoid two dates."]},
    {"scene":"calendar","parts":["Now 363 days remain."],"speech":"Now three hundred and sixty-three days remain."},
    {"scene":"product","parts":["Keep multiplying those chances","as people enter."]},
    {"scene":"product","parts":["At twenty-three people,","the chance that every birthday","is different is about 49.3%."],"speech":"At twenty-three people, the chance that every birthday is different is about forty-nine point three percent."},
    {"scene":"reveal","parts":["So at least one shared birthday","is the rest:"],"pause":0.15},
    {"scene":"reveal","parts":["about 50.7%."],"speech":"about fifty point seven percent.","pause":0.65},
    {"scene":"model","parts":["For this classic calculation,","assume independent birthdays,"],"pause":0.1},
    {"scene":"model","parts":["equally likely across 365 days.","Ignore leap day."],"speech":"equally likely across three hundred and sixty-five days. Ignore leap day."},
    {"scene":"curve","parts":["That does not promise a match","in this particular room."]},
    {"scene":"curve","parts":["It means that across many such rooms,","just over half would have one."]},
    {"scene":"curve","parts":["And with fifty people,","the chance exceeds 97%."],"speech":"And with fifty people, the chance exceeds ninety-seven percent."},
    {"scene":"close","parts":["The surprise was never","how many birthdays fit in a year."]},
    {"scene":"close","parts":["It was how many comparisons","fit in a room."]},
    {"scene":"close","parts":["Your intuition counted people.","The probability counted pairs."],"pause":0.8}
  ]
}
